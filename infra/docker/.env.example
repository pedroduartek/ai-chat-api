# Copy this file to infra/docker/.env on the VPS and fill values before running compose up

# Ollama model to use (preferred: llama3.2:1b)
OLLAMA_MODEL=llama3.2:1b
# Optional: override the base URL the API uses to reach Ollama (internal compose hostname by default)
# OLLAMA_BASE_URL=http://ollama:11434

# ── Grafana Cloud Loki ──────────────────────────────────────────────────
# Use the BASE URL only — the Serilog sink appends /loki/api/v1/push automatically.
GRAFANA_LOKI_URL=https://logs-prod-043.grafana.net
GRAFANA_LOKI_USER=<your_loki_user_id>
GRAFANA_LOKI_API_KEY=<your_grafana_cloud_api_key>
