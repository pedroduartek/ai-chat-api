{
    # Global options — set an admin email if you'd like automatic TLS notifications
    # email you@example.com
}

# Route the API domain to the internal `api` service. Caddy will handle TLS automatically
# if the domain resolves to this VPS and ports 80/443 are open.
api.pedroduartek.com {
        tls internal

        # ── Security headers (defense-in-depth alongside application-level headers) ──
        header {
                Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
                X-Content-Type-Options    "nosniff"
                X-Frame-Options           "DENY"
                Referrer-Policy           "strict-origin-when-cross-origin"
                Permissions-Policy        "camera=(), microphone=(), geolocation=()"
                Content-Security-Policy   "default-src 'none'"
                # Remove server identification headers
                -Server
                -X-Powered-By
        }

        # Simple access log to stdout for debugging routing issues
        log {
                output stdout
                format single_field common_log
        }

        # Proxy to the api service; preserve the original Host and forwarding headers
        reverse_proxy api:80 {
                header_up Host {http.request.host}
                header_up X-Forwarded-Proto {http.request.scheme}
                header_up X-Forwarded-For {http.request.remote}
        }
}
