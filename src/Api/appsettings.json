{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Warning",
      "Override": {
        "Api": "Information",
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.AspNetCore.Hosting.Diagnostics": "Error",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "formatter": "Serilog.Formatting.Compact.RenderedCompactJsonFormatter, Serilog.Formatting.Compact"
        }
      }
    ],
    "Enrich": [
      "FromLogContext"
    ]
  },
  "Chat": {
    "BaseUrl": "http://ollama:11434",
    "ChatEndpoint": "/api/chat",
    "Model": "llama3.2:1b",
    "Temperature": 0.3,
    "TopP": 0.9,
    "TopK": 40,
    "RepeatPenalty": 1.1,
    "NumPredict": 256,
    "NumCtx": 2048
  },
  "Warmup": {
    "Enabled": true,
    "IntervalMinutes": 2
  },
  "Resilience": {
    "TotalTimeoutSeconds": 25,
    "AttemptTimeoutSeconds": 12,
    "MaxRetryAttempts": 2,
    "RetryBaseDelayMilliseconds": 300,
    "CircuitBreakerFailureRatio": 0.5,
    "CircuitBreakerSamplingSeconds": 30,
    "CircuitBreakerMinimumThroughput": 6,
    "CircuitBreakerDurationSeconds": 15
  },
  "Turnstile": {
    "Enabled": true,
    "SiteVerifyUrl": "https://challenges.cloudflare.com/turnstile/v0/siteverify",
    "TimeoutSeconds": 10,
    "AllowedHostnames": [
      "pedroduartek.com",
      "www.pedroduartek.com"
    ]
  },
  "Swagger": {
    "Enabled": true
  },
  "RateLimiting": {
    "TokensPerPeriod": 100,
    "ReplenishmentPeriodSeconds": 60,
    "Chat": {
      "TokensPerPeriod": 12,
      "ReplenishmentPeriodSeconds": 60
    },
    "ChatStream": {
      "PermitLimit": 4,
      "WindowSeconds": 60
    },
    "Email": {
      "PermitLimit": 3,
      "WindowSeconds": 3600
    },
    "Health": {
      "PermitLimit": 30,
      "WindowSeconds": 60
    }
  },
  "Email": {
    "SmtpHost": "smtp-relay.brevo.com",
    "SmtpPort": 587,
    "Username": "apikey",
    "From": "no-reply@example.com",
    "Recipient": "pedroduartek@gmail.com",
    "UseSsl": true,
    "TimeoutSeconds": 30
  }
}
