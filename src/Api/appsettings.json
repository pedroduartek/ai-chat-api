{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Warning",
      "Override": {
        "Api": "Information",
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.AspNetCore.Hosting.Diagnostics": "Error",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "formatter": "Serilog.Formatting.Json.JsonFormatter, Serilog"
        }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "Chat": {
    "ClientName": "ollama",
    "BaseUrl": "http://ollama:11434",
    "ChatEndpoint": "/api/chat",
    "Model": "llama3.2:1b",
    "Temperature": 0.3,
    "TopP": 0.9,
    "TopK": 40,
    "RepeatPenalty": 1.1,
    "NumPredict": 256,
    "NumCtx": 2048
  },
  "RateLimiting": {
    "TokensPerPeriod": 100,
    "ReplenishmentPeriodSeconds": 60
  }
}
